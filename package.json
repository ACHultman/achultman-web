{
    "private": true,
    "name": "hultman-dev",
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack",
        "start": "next start",
        "test:e2e": "playwright test",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "analyze": "ANALYZE=true next build --webpack",
        "lhci": "npm run build && npx lhci autorun --config .lighthouserc.js",
        "a11y": "playwright test --project=accessibility",
        "test": "node --test tests/*.test.cjs",
        "typecheck": "tsc --noEmit",
        "check": "npm run prettier:check && npm run lint && npm run typecheck && npm test"
    },
    "dependencies": {
        "@chakra-ui/icons": "^2.2.4",
        "@chakra-ui/react": "^2.10.10",
        "@chakra-ui/theme-tools": "^2.1.2",
        "@emotion/react": "^11.13.3",
        "@emotion/server": "^11.11.0",
        "@emotion/styled": "^11.13.0",
        "@notionhq/client": "^5.27.0",
        "@opentelemetry/api": "^1.9.1",
        "@upstash/ratelimit": "^2.2.0",
        "@upstash/redis": "^1.36.4",
        "@vercel/analytics": "^1.3.1",
        "@vercel/functions": "^1.4.2",
        "@vercel/speed-insights": "^1.2.0",
        "framer-motion": "^12.35.1",
        "next": "16.4.0",
        "next-seo": "^6.6.0",
        "nodemailer": "^10.1.4",
        "posthog-js": "^1.356.1",
        "posthog-node": "^5.21.2",
        "prismjs": "^1.30.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-icons": "5.3.0",
        "tone": "^15.1.22",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.1",
        "@lhci/cli": "^0.15.1",
        "@next/bundle-analyzer": "16.4.0",
        "@playwright/test": "^1.64.0",
        "@types/node": "^24.0.0",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.12.0",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.5",
        "pa11y-ci": "^5.0.0",
        "prettier": "^3.9.10",
        "typescript": "^5.6.3"
    },
    "overrides": {
        "postcss": "^8.5.23",
        "qs": "^6.16.0",
        "tmp": "^0.2.7",
        "@lhci/cli": {
            "lighthouse": "13.5.0",
            "uuid": "11.1.1",
            "proxy-agent": "8.0.2"
        },
        "@lhci/utils": {
            "lighthouse": "13.5.0"
        },
        "js-yaml@3": {
            "argparse": "2.0.1"
        },
        "get-uri": {
            "basic-ftp": "6.2.3"
        },
        "@next/eslint-plugin-next": {
            "fast-glob": "npm:tinyglobby@0.2.17"
        },
        "eslint-config-next": {
            "eslint-plugin-react": {
                "eslint": "$eslint"
            },
            "eslint-plugin-jsx-a11y": {
                "eslint": "$eslint"
            },
            "eslint-plugin-import": {
                "eslint": "$eslint"
            }
        }
    },
    "browserslist": {
        "production": [
            "last 2 Chrome versions",
            "last 2 Firefox versions",
            "last 2 Safari versions",
            "not IE 11"
        ],
        "development": [
            "last 1 Chrome version",
            "last 1 Firefox version",
            "last 1 Safari version"
        ]
    },
    "engines": {
        "node": "24.x"
    }
}
