# see https://support.google.com/accounts/answer/185833?visit_id=638826186223006951-2415500055
EMAIL_PASS=
NEXT_PUBLIC_EMAIL=

NOTION_API_KEY=
NOTION_DATABASE_ID_BOOKS=
NOTION_DATABASE_ID_BLOG=
NOTION_DATABASE_ID_BOOKMARKS=
# Optional for a database with one source; required to choose among multiple sources.
NOTION_DATA_SOURCE_ID_BLOG=
NOTION_DATA_SOURCE_ID_BOOKS=
NOTION_DATA_SOURCE_ID_BOOKMARKS=

# Opt in only for a standalone production-mode preview without Notion.
# Development previews work without credentials. Leave false on the live site.
NOTION_PREVIEW_MODE=false

# Canonical public domain for metadata, sitemap, and RSS, including local previews.
NEXT_PUBLIC_SITE_URL=https://hultman.dev
# Runtime app URL (e.g. for local browser tests); separate from canonical URLs.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Required for production API abuse protection (Upstash Redis).
# If absent or unavailable, API requests fail closed with 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing Vercel KV deployments may retain the complete KV_REST_API_URL /
# KV_REST_API_TOKEN pair until rotated. Do not mix the two naming schemes.
